{
	"name": "@3sixty/standards-unece",
	"version": "0.20.0-next.0",
	"description": "Data models for UN/CEFACT semantic vocabularies.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/standards.git",
		"directory": "packages/standards-unece"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage src/compiled",
		"build:country-to-json-compressed": "node ./scripts/country-to-json-compressed.mjs",
		"build:generate-interfaces": "node ./scripts/generate-interfaces.mjs",
		"build:schema": "ts-to-schema ./ts-to-schema.json ./src/schemas ./src/compiled",
		"build:compile": "tspc",
		"build": "pnpm run build:generate-interfaces && pnpm run build:schema && pnpm run build:compile",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"copy-data": "copyfiles -u 1 \"src/data/**/*\" \"dist/es/\"",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && pnpm run build && concurrently -g -n locales,copy-data,types,test \"pnpm run validate-locales\" \"pnpm run copy-data\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && pnpm run build && concurrently -g -n locales,copy-data,types \"pnpm run validate-locales\" \"pnpm run copy-data\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/core": "next",
		"@3sixty/data-core": "next",
		"@3sixty/data-json-ld": "next",
		"@3sixty/entity": "next",
		"@3sixty/nameof": "next"
	},
	"devDependencies": {
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/ts-to-schema": "next",
		"@3sixty/validate-locales": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"standards",
		"schema",
		"specification",
		"unece",
		"supply-chain"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/standards/issues"
	},
	"homepage": "https://3sixty.global"
}
