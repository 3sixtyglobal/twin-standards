{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"**/src-data/**",
		"**/ldContexts/*.json",
		"changelog.md",
		"**/schemas",
		"ts-to-schema.json"
	],
	"words": [
		"abbrev",
		"activitystreams",
		"autorelease",
		"bday",
		"cefact",
		"codelists",
		"cryptosuite",
		"Dataspace",
		"DCAT",
		"DCMI",
		"dcmitype",
		"dcterms",
		"dublincore",
		"eddsa",
		"EORI",
		"epc",
		"epcis",
		"EUID",
		"foaf",
		"GLEIF",
		"gteq",
		"iepc",
		"ilmd",
		"jaif",
		"lgtin",
		"linkml",
		"LinkML",
		"lteq",
		"masterdata",
		"Multibase",
		"Multikey",
		"nameof",
		"Odrl",
		"perc",
		"prov",
		"rdfc",
		"sgln",
		"sgtin",
		"SHACL",
		"Stiftung",
		"unece",
		"vcard",
		"vocab",
		"xone"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm"
	]
}
